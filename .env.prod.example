# ==============================================================================
# CONFIGURAÇÕES DE PRODUÇÃO - B3 INVESTIMENTOS (VPS)
# ==============================================================================
# Copie este arquivo para .env.prod no servidor:
#   cp .env.prod.example .env.prod
#
# E preencha os valores de acordo com a sua infraestrutura compartilhada.
# ==============================================================================

# 1. Banco de Dados MySQL Central (infra-compartilhada)
DB_PASSWORD=sua_senha_do_mysql_central

# 2. Redis Central (infra-compartilhada) - Deixe vazio se não tiver senha
REDIS_PASSWORD=

# 3. Autenticação JWT (Chave secreta longa para assinar tokens de usuários)
JWT_SECRET=gere_uma_chave_secreta_longa_e_aleatoria_para_jwt_aqui

# 4. URL Pública da API para o Front-end
# No navegador do usuário, as requisições irão para este endereço.
# Exemplo com Domínio: https://api.invest.seudominio.com.br (ou https://api-carteira.seudominio.com.br)
# Exemplo inicial com IP: http://179.236.230.139:8080
NEXT_PUBLIC_API_URL=http://179.236.230.139:8080

# 5. Rede Docker compartilhada (Opcional - O deploy.sh detecta automaticamente do mysql_central)
# DOCKER_NETWORK=infra-compartilhada_default

